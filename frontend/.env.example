# Copy to frontend/.env.local. See docs/GOOGLE_MAPS_LOCAL_SETUP.md. Never commit real values.
# Public browser configuration; these values are visible in built JavaScript.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
# Maps JavaScript API only: website-restricted browser key (visible to browsers).
VITE_GOOGLE_MAPS_API_KEY=

# Server configuration. Never prefix server secrets with VITE_.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
# Separate server key: Places API (New), Routes API, Geocoding API. Never VITE_.
GOOGLE_MAPS_SERVER_API_KEY=

# Optional migration credential for the imported frontend schema only.
# Do not apply frontend/drizzle migrations to the main backend DB automatically.
LOVABLE_DB_MIGRATION_URL=

# Development-only same-origin /api proxy. No credentials in this URL.
SIDEBY_API_ORIGIN=http://127.0.0.1:3000
