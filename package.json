{
  "name": "sideby",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "dev:local": "tsx scripts/local.ts",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "schemas:venues": "tsx scripts/generate-venue-schema.ts",
    "venues:import-government": "tsx scripts/import-government-venues.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "test:backend": "tsx --test --test-concurrency=1 tests/backend.test.ts",
    "test:venue-data": "tsx --test tests/venue-data.test.ts",
    "test": "npm run test:backend && npm run test:venue-data"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "next": "16.3.4",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "embedded-postgres": "18.4.0-beta.17",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
